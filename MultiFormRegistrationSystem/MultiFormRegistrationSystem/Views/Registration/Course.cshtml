
@{
    ViewBag.Title = "Course";
}

<h2 class="text-center mb-4">Course Registration</h2>

<form method="post">
    <label class="form-label">Course Name</label>
    <input type="text" class="form-control mb-3" name="coursename" placeholder="Enter Course Name">

    <label class="form-label">Course Duration</label>
    <input type="text" class="form-control mb-3" name="courseduration" placeholder="Enter Course Duration">

    <label class="form-label">Course Fees</label>
    <input type="number" class="form-control mb-3" name="coursefees" placeholder="Enter Course Fees">

    <label class="form-label">Student Name</label>
    <input type="text" class="form-control mb-3" name="studentname" placeholder="Enter Student Name">

    <label class="form-label">Admission Date</label>
    <input type="date" class="form-control mb-3" name="admissiondate">

    <button type="submit" class="btn btn-primary">Submit</button>

</form>
