
@{
    ViewBag.Title = "Student";
}
    <h2 class="text-center mb-4">Student Registration</h2>

    <form method="post">
        <label class="form-label">Student Name</label>
        <input type="text" class="form-control mb-3" name="name" placeholder="Enter Student Name">

        <label class="form-label">Email</label>
        <input type="email" class="form-control mb-3" name="email" placeholder="Enter Email">

        <label class="form-label">Mobile Number</label>
        <input type="tel" class="form-control mb-3" name="mobile" placeholder="Enter Mobile Number">

        <label class="form-label">Date of Birth</label>
        <input type="date" class="form-control mb-3" name="dob">

        <label class="form-label">Gender</label>
        <select class="form-select mb-3" name="gender">
            <option selected disabled>Select Gender</option>
            <option>Male</option>
            <option>Female</option>
            <option>Other</option>
        </select>

        <label class="form-label">Address</label>
        <textarea class="form-control mb-3" name="address" rows="3" placeholder="Enter Address"></textarea>

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>


