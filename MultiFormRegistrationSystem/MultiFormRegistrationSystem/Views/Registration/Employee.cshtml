
@{
    ViewBag.Title = "Employee";
}

<h2 class="text-center mb-4">Employee Registration</h2>

<form method="post">

    <label class="form-label">Employee Name</label>
    <input type="text" class="form-control mb-3" name="name" placeholder="Enter Employee Name">

    <label class="form-label">Email</label>
    <input type="email" class="form-control mb-3" name="email" placeholder="Enter Email">

    <label class="form-label">Mobile Number</label>
    <input type="tel" class="form-control mb-3" name="mobile" placeholder="Enter Mobile Number">

    <label class="form-label">Department</label>
    <input type="text" class="form-control mb-3" name="department" placeholder="Enter Department">

    <label class="form-label">Salary</label>
    <input type="number" class="form-control mb-3" name="salary" placeholder="Enter Salary">

    <label class="form-label">Joining Date</label>
    <input type="date" class="form-control mb-3" name="joiningdate">

    <button type="submit" class="btn btn-primary">Submit</button>

</form>
